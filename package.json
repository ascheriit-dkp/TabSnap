{
  "name": "tabsnap",
  "version": "0.4.0-alpha.1",
  "private": true,
  "description": "Move a browser workspace between machines without a backend.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm extension:build && pnpm docs:build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm extension:build && pnpm extension:audit && pnpm extension:edge-audit && pnpm extension:firefox-build && pnpm extension:firefox-audit && pnpm extension:firefox-lint && pnpm store:audit && pnpm docs:build",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress docs",
    "docs:preview": "vitepress preview docs",
    "extension:audit": "node scripts/audit-extension.mjs",
    "extension:edge-audit": "node scripts/audit-edge-package.mjs",
    "extension:firefox-audit": "node scripts/audit-firefox-package.mjs",
    "extension:firefox-build": "node scripts/build-firefox-package.mjs",
    "extension:firefox-lint": "web-ext lint --source-dir apps/chrome-extension/dist-firefox",
    "extension:build": "pnpm --filter @tabsnap/chrome-extension build",
    "extension:dev": "pnpm --filter @tabsnap/chrome-extension dev",
    "extension:e2e": "playwright test --config=playwright.config.ts",
    "store:audit": "node scripts/audit-store-readiness.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.base.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "eslint": "10.11.0",
    "prettier": "3.9.8",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.1",
    "vitepress": "1.6.4",
    "vitest": "5.0.1",
    "web-ext": "10.7.0"
  }
}
