{
  "name": "tabsnap",
  "version": "0.0.0",
  "private": true,
  "description": "Move a browser workspace between machines without a backend.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm extension:build && pnpm docs:build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm extension:build && pnpm docs:build",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress docs",
    "docs:preview": "vitepress preview docs",
    "extension:build": "pnpm --filter @tabsnap/chrome-extension build",
    "extension:dev": "pnpm --filter @tabsnap/chrome-extension dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.base.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.0",
    "vitepress": "1.6.4",
    "vitest": "5.0.0"
  }
}
