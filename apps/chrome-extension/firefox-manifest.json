{
  "manifest_version": 3,
  "name": "TabSnap",
  "version": "0.3.0",
  "version_name": "0.3.0-alpha.5",
  "description": "Move a browser workspace between machines without a backend.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["tabs", "tabGroups"],
  "optional_host_permissions": ["http://127.0.0.1/*"],
  "action": {
    "default_title": "Open TabSnap",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tabsnap@ascheriit-dkp.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": ["browsingActivity"]
      }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
